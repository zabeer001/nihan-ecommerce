VITE_APP_NAME="${APP_NAME}"

# Docker/Sail local ports and user IDs.
APP_PORT=1006
FORWARD_DB_PORT=3307
PHPMYADMIN_PORT=8181
WWWGROUP=1000
WWWUSER=1000
SAIL_XDEBUG_MODE=off
SAIL_XDEBUG_CONFIG=client_host=host.docker.internal

# Production changes:
# APP_ENV=production
# APP_DEBUG=false
# APP_URL=https://your-production-domain.com
# LOG_LEVEL=warning
# DB_DATABASE=your_production_database
# DB_USERNAME=your_production_database_user
# DB_PASSWORD=replace_with_a_strong_database_password
# MYSQL_ROOT_PASSWORD=replace_with_a_different_strong_root_password
# SESSION_SECURE_COOKIE=true
# MAIL_MAILER=smtp
# MAIL_HOST=your_smtp_host
# MAIL_PORT=587
# MAIL_USERNAME=your_smtp_username
# MAIL_PASSWORD=your_smtp_password
# MAIL_FROM_ADDRESS=no-reply@your-production-domain.com
# APP_PORT=97
# PHPMYADMIN_PORT=8082
# SAIL_XDEBUG_MODE=off
#
# Production notes:
# - Generate APP_KEY with: php artisan key:generate --show
# - Use docker-compose.prod.yml in production; it binds app/phpMyAdmin to 127.0.0.1 for reverse proxy access.
# - Do not expose MySQL publicly in production; docker-compose.prod.yml keeps MySQL off the host network.
# - Set real secrets on the server instead of committing production values to git.

